# ========================================================
# QueueLess Backend Environment Variables
# ========================================================

PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/queueless

# JWT Secret
JWT_SECRET=replace_with_secure_production_jwt_secret_key_minimum_32_characters

# CORS Client Whitelist
CLIENT_URL=http://localhost:5173

# ========================================================
# QueueLess Environment Variables
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI)
# Requires MongoDB 4.4+ (Replica Set recommended for enterprise deployments, standalone supported via atomic conditional reservations)
MONGO_URI=mongodb://127.0.0.1:27017/queueless

# Authentication & Security
# Generate a cryptographically secure random secret (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_secure_production_jwt_secret_key_minimum_32_characters

# Client Origin (CORS whitelist)
CLIENT_URL=http://localhost:5173
